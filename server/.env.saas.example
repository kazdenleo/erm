# Скопируйте нужные строки в server/.env на VPS (/opt/erm/server/.env).
# Не коммитьте реальные секреты.

NODE_ENV=production
# JWT_SECRET и SECRETS_ENCRYPTION_KEY на проде уже должны быть заданы (≥32 / 64 hex).

# Закрытая бета — публичную регистрацию НЕ включайте:
# PUBLIC_SIGNUP_ENABLED=1

# Автовыдача демо с /demo (по умолчанию включена):
# DEMO_REQUEST_ENABLED=1
# DEMO_TRIAL_DAYS=7

LEGAL_BRAND=MySell
LEGAL_COMPANY=
LEGAL_INN=
LEGAL_OGRN=
LEGAL_ADDRESS=
LEGAL_EMAIL=
LEGAL_TELEGRAM=
LEGAL_DOMAIN=mysell.su
LEGAL_REVISED_AT=2026-11-20

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://mysell.su/pricing

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MySell <noreply@mysell.su>

# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SENTRY_DSN=
